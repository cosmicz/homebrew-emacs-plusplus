+(ert-deftest process-tests/delete-process-other-thread-waiting ()
+  "Deleting a process must not abort Emacs when another thread waits.
+While a thread is blocked in `accept-process-output' with no process
+argument, its `pselect' call watches the descriptors of every process
+that is not locked to another thread.  Deleting such a process from a
+different thread closes a descriptor under that call, which on some
+systems then fails with EBADF.  Emacs used to abort on that error."
+  (skip-unless (fboundp 'make-thread))
+  (let* ((proc (make-pipe-process :name "test" :noquery t
+                                  :filter #'ignore :sentinel #'ignore))
+         ;; A fresh object.  Only the thread below can return it, and
+         ;; only after its wait has returned normally.
+         (done (list 'wait-returned))
+         (entered nil)
+         (thread (make-thread
+                  (lambda ()
+                    (setq entered t)
+                    (accept-process-output nil 1)
+                    done))))
+    (unwind-protect
+        (let ((deadline (+ (float-time) 10)))
+          (while (and (not entered) (< (float-time) deadline))
+            (thread-yield))
+          (should entered)
+          ;; The new thread holds the global lock from setting ENTERED
+          ;; until it first releases it inside select.  The delay below
+          ;; then lets it reach its long wait.  Under heavy load the
+          ;; deletion can still come first; the test then passes without
+          ;; exercising the bug, it never fails because of it.
+          (sleep-for 0.1)
+          (delete-process proc)
+          ;; `thread-join' returns the value of the thread's function.
+          ;; That is DONE only if the wait returned normally in this
+          ;; very thread; a thread that exits by a signal returns no
+          ;; value.  Errors of other threads play no part.
+          (should (eq (thread-join thread) done))
+          (should-not (process-live-p proc)))
+      (when (process-live-p proc)
+        (delete-process proc))
+      (when (thread-live-p thread)
+        (ignore-errors (thread-join thread))))))
 
