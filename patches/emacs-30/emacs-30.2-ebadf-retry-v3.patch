+/* Return true if a descriptor that wait_reading_process_output
+   still expects to wait for is not an open file descriptor.  WAIT_PROC
+   is the process the caller waits for, or NULL.  */
+static bool
+registered_descriptor_closed_p (struct Lisp_Process *wait_proc)
+{
+  int child_fd = child_signal_read_fd;
+  if (0 <= child_fd && fcntl (child_fd, F_GETFD) < 0 && errno == EBADF)
+    return true;
+  if (wait_proc && 0 <= wait_proc->infd
+      && fcntl (wait_proc->infd, F_GETFD) < 0 && errno == EBADF)
+    return true;
+  for (int fd = 0; fd <= max_desc; fd++)
+    if ((fd_callback_info[fd].flags & (FOR_READ | FOR_WRITE)) != 0
+	&& fcntl (fd, F_GETFD) < 0 && errno == EBADF)
+      return true;
+  return false;
+}
+
 /* This is here so breakpoints can be put on it.  */
 static void
 wait_reading_process_output_1 (void)
@@ -5828,7 +5847,19 @@
 	  if (xerrno == EINTR)
