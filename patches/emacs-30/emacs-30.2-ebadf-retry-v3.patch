 	  else if (xerrno == EBADF)
-	    emacs_abort ();
+	    {
+	      /* Another Lisp thread can close a descriptor that is in
+		 our wait masks while thread_select has released the
+		 global lock, for example by deleting a process.  That
+		 descriptor is no longer registered, so the masks
+		 computed on the next iteration will not contain it;
+		 just try again.  Abort only if a descriptor that is
+		 still registered is not open, which means that the
+		 bookkeeping in this file is broken.  */
+	      if (registered_descriptor_closed_p (wait_proc))
+		emacs_abort ();
+	      no_avail = 1;
+	    }
 	  else
