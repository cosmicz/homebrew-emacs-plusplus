+(ert-deftest threads-last-error-per-thread ()
+  "Test that each thread keeps the error form it exited with."
+  (skip-unless (featurep 'threads))
+  (let* ((payload (list 'payload))
+         (th1 (make-thread (lambda ()
+                             (signal 'wrong-type-argument (list payload)))))
+         (th2 (make-thread (lambda () (error "Second")))))
+    (while (or (thread-live-p th1) (thread-live-p th2))
+      (thread-yield))
+    (should (equal (thread-last-error nil th1)
+                   '(wrong-type-argument (payload))))
+    ;; The form is the one that was signaled, not a copy of it.
+    (should (eq (cadr (thread-last-error nil th1)) payload))
+    (should (equal (thread-last-error nil th2) '(error "Second")))
+    ;; A thread that fails later replaces only the form that is not
+    ;; tied to a thread.
+    (let ((th3 (make-thread (lambda () (error "Third")))))
+      (while (thread-live-p th3)
+        (thread-yield))
+      (should (equal (thread-last-error) '(error "Third")))
+      (should (equal (thread-last-error nil th1)
+                     '(wrong-type-argument (payload))))
+      (should (equal (thread-last-error nil th2) '(error "Second")))
+      ;; Cleanup with a thread removes the form of that thread only.
+      (should (equal (thread-last-error 'cleanup th3) '(error "Third")))
+      (should-not (thread-last-error nil th3))
+      (should (equal (thread-last-error) '(error "Third")))
+      (should (equal (thread-last-error nil th2) '(error "Second")))
+      ;; Cleanup without a thread leaves the forms of threads alone.
+      (should (equal (thread-last-error 'cleanup) '(error "Third")))
+      (should-not (thread-last-error))
+      (should (equal (thread-last-error nil th1)
+                     '(wrong-type-argument (payload))))
+      (should (equal (thread-last-error nil th2) '(error "Second"))))))
 
+(ert-deftest threads-last-error-normal-exit ()
+  "Test that a normal exit and a failure are told apart per thread."
+  (skip-unless (featurep 'threads))
+  (let ((ok (make-thread #'ignore))
+        (failed (make-thread (lambda () (signal 'error nil)))))
+    (while (or (thread-live-p ok) (thread-live-p failed))
+      (thread-yield))
+    ;; Neither thread function produced a value; only one of them failed.
+    (should-not (thread-last-error nil ok))
+    (should (equal (thread-last-error nil failed) '(error)))
+    ;; A live thread has no error form.
+    (should-not (thread-last-error nil (current-thread)))
+    (should-not (thread-last-error nil main-thread))
+    (thread-last-error 'cleanup)))
+
+(ert-deftest threads-last-error-wrong-type ()
+  "Test that `thread-last-error' rejects a THREAD that is not a thread."
+  (skip-unless (featurep 'threads))
+  (should-error (thread-last-error nil 'not-a-thread)
+                :type 'wrong-type-argument)
+  (should-error (thread-last-error 'cleanup "not a thread")
+                :type 'wrong-type-argument)
+  (should-error (thread-last-error nil (make-mutex))
+                :type 'wrong-type-argument))
+
+(defun threads-signal-fresh-payload (table)
+  "Signal an error whose data is a fresh object registered in TABLE.
+TABLE should be a hash table with weak keys.  Nothing but the error
+form refers to the object once this function has exited."
+  (let ((payload (list 'payload (make-string 64 ?x))))
+    (puthash payload t table)
+    (signal 'error (list payload))))
+
+(ert-deftest threads-last-error-survives-gc ()
+  "Test that a thread object keeps its error form alive."
+  (skip-unless (featurep 'threads))
+  (let* ((table (make-hash-table :test 'eq :weakness 'key))
+         (thread (make-thread
+                  (lambda () (threads-signal-fresh-payload table)))))
+    (while (thread-live-p thread)
+      (thread-yield))
+    ;; Let another failure replace the form that is not tied to a
+    ;; thread, then drop that one too.
+    (let ((other (make-thread (lambda () (error "Other")))))
+      (while (thread-live-p other)
+        (thread-yield)))
+    (should (equal (thread-last-error 'cleanup) '(error "Other")))
+    (garbage-collect)
+    ;; This is checked before the form is read back: only THREAD can
+    ;; have kept the payload alive.
+    (should (= (hash-table-count table) 1))
+    (should (equal (thread-last-error nil thread)
+                   `(error (payload ,(make-string 64 ?x)))))))
+
+(ert-deftest threads-last-error-collectible ()
+  "Test that a thread's error form can be collected once it is removed.
+The garbage collector scans the C stack conservatively, so a stale
+value there can keep the payload alive; hence the `:unstable' tag."
+  :tags '(:unstable)
+  (skip-unless (featurep 'threads))
+  (let* ((table (make-hash-table :test 'eq :weakness 'key))
+         (thread (make-thread
+                  (lambda () (threads-signal-fresh-payload table)))))
+    (while (thread-live-p thread)
+      (thread-yield))
+    (thread-last-error 'cleanup)
+    (garbage-collect)
+    (should (= (hash-table-count table) 1))
+    (thread-last-error 'cleanup thread)
+    (garbage-collect)
+    (should (= (hash-table-count table) 0))))
+
